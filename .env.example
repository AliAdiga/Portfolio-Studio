# Public site address. Without it the site is marked noindex and share links point at localhost.
NEXT_PUBLIC_SITE_URL=

# Inquiry form delivery (server-side only; never prefixed with NEXT_PUBLIC_).
# Without these the form keeps the visitor's text and offers a prepared email instead.
INQUIRY_PROVIDER_API_KEY=
INQUIRY_TO=
INQUIRY_FROM=
# Optional. Defaults to Resend's endpoint (https://api.resend.com/emails).
# INQUIRY_PROVIDER_URL=
